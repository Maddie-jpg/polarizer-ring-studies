+# ===========================================================================
+# Shared spin-tracking analysis helpers.
+#
+# Moved here from spin_tracking.py / spin_tracking_single_seed.py /
+# spin_track_fitted.py, which each had their own copy of this logic that had
+# drifted out of sync (different misalignment sigmas, different reliability
+# checks, missing keys referenced by callers, etc). Everything below is the
+# single shared implementation; the three scripts now just call it.
+# ===========================================================================
+
+TAU_MIN_TURNS = 1000  # floor on fitted depolarization time, in turns
+
+
+def exp_decay(t, a, tauinv):
+    return a * np.exp(-tauinv * t)
+
+
+def two_step_exp_fit(t, p, amp_bounds=(0.9, 1.1), tau_min_turns=TAU_MIN_TURNS):
+    """Two-step fit: lstsq gives a robust starting guess, curve_fit refines it
+    within bounds. Returns (popt, pcov) with popt = [a, tauinv].
+
+    Bounded so an unconstrained fit on a trace dominated by shot noise (no
+    visible trend) can't converge on an almost-zero decay rate, which would
+    invert to an astronomically large, meaningless tau_depol. fit_is_reliable()
+    below flags those cases explicitly instead of letting them look valid.
+    """
+    t = np.asarray(t, dtype=float)
+    p = np.asarray(p, dtype=float)
+
+    A = np.vstack([t, np.ones_like(t)]).T
+    lin_slope, intercept = np.linalg.lstsq(A, p, rcond=None)[0]
+    tauinv0 = -lin_slope / intercept if intercept != 0 else 0.0
+
+    tauinv_max = 1.0 / tau_min_turns
+    p0 = [np.clip(intercept, *amp_bounds), np.clip(tauinv0, 0.0, tauinv_max)]
+    bounds = ([amp_bounds[0], 0.0], [amp_bounds[1], tauinv_max])
+
+    popt, pcov = curve_fit(exp_decay, t, p, p0=p0, bounds=bounds, maxfev=10000)
+    return popt, pcov
+
+
+def fit_is_reliable(t, p, popt, min_snr=3.0):
+    """A fitted decay is only trustworthy if the amplitude it predicts the
+    signal moves by, over the tracked window, is well above the noise floor
+    of the residuals. Otherwise the fit is just tracking noise."""
+    a, tauinv = popt
+    if not (np.isfinite(tauinv) and tauinv > 0):
+        return False
+    n = len(t)
+    predicted_amplitude_change = a * (1 - np.exp(-tauinv * n))
+    residual_rms = np.std(p - exp_decay(t, *popt))
+    if residual_rms == 0:
+        return True
+    return predicted_amplitude_change > min_snr * residual_rms
+
+
+def compute_polarization_trace(mon, fixed_denominator=None):
+    """Turn-by-turn beam polarization P(t) = |<S>| from a tracking monitor.
+
+    By default normalizes by the number of surviving particles each turn
+    (mask_alive.sum(axis=0)). Pass fixed_denominator=num_particles to instead
+    divide by the initial particle count everywhere (biased low once losses
+    start, but matches how spin_track_fitted.py used to do it) -- a warning
+    is printed if losses are detected in that mode.
+
+    Returns (pol, n_alive).
+    """
+    mask_alive = mon.state > 0
+    n_alive = mask_alive.sum(axis=0)
+    denom = n_alive if fixed_denominator is None else fixed_denominator
+    if fixed_denominator is not None and n_alive.min() < fixed_denominator:
+        print(f"  WARNING: particle losses detected (min alive = "
+              f"{n_alive.min()}/{fixed_denominator}) -- the fixed-denominator "
+              f"polarization is biased low after losses begin.")
+    pol_x = mon.spin_x.sum(axis=0) / denom
+    pol_y = mon.spin_y.sum(axis=0) / denom
+    pol_z = mon.spin_z.sum(axis=0) / denom
+    pol = np.sqrt(pol_x**2 + pol_y**2 + pol_z**2)
+    return pol, n_alive
+
+
+def fit_depolarization(turns, pol, tw, icTrns, seed_label=''):
+    """Fit the turn-by-turn polarization trace to a decaying exponential and
+    return the fitted depolarization time, falling back to the analytic
+    t_depol from `tw` if the fit isn't reliable (e.g. shot noise with no
+    resolvable decay over the tracked window).
+
+    Returns a dict with:
+      t_dep_turns_all   - tau (turns) from a fit over the full trace
+      t_dep_turns_long  - tau (turns) from a fit over turns[icTrns:] (primary)
+      fit_curve         - fitted curve (cut fit), same length as `turns`
+      fit_curve_all     - fitted curve (all-turns fit), same length as `turns`
+      fit_reliable      - bool, whether the cut fit passed the reliability check
+      icTrns            - transient cutoff actually used
+    """
+    n_turns_rec = len(pol)
+    try:
+        popt_all, _ = two_step_exp_fit(turns, pol)
+        popt_cut, _ = two_step_exp_fit(turns[icTrns:], pol[icTrns:])
+        amp_all, tauinv_all = popt_all
+        amp_cut, tauinv_cut = popt_cut
+        t_dep_turns_all = 1.0 / tauinv_all if tauinv_all > 0 else np.nan
+        t_dep_turns_long = 1.0 / tauinv_cut if tauinv_cut > 0 else np.nan
+        fit_curve = exp_decay(turns, amp_cut, tauinv_cut)
+        fit_curve_all = exp_decay(turns, amp_all, tauinv_all)
+        fit_reliable = (
+            np.isfinite(t_dep_turns_long)
+            and t_dep_turns_long < 100 * n_turns_rec
+            and fit_is_reliable(turns[icTrns:], pol[icTrns:], popt_cut)
+        )
+    except (RuntimeError, ValueError) as e:
+        print(f"  {seed_label}Exponential fit failed: {e}")
+        t_dep_turns_all = np.nan
+        t_dep_turns_long = np.nan
+        fit_curve = np.full_like(pol, np.nan)
+        fit_curve_all = np.full_like(pol, np.nan)
+        fit_reliable = False
+
+    # Fall back to the analytic depol time if the tracked fit isn't reliable.
+    if not fit_reliable or not np.isfinite(t_dep_turns_long):
+        t_depol = tw.spin_t_depol_component_s
+        t_dep_turns_long = t_depol / tw.T_rev0
+        fit_reliable = False
+        print(f"  {seed_label}fit unreliable -- using analytic t_depol = "
+              f"{t_dep_turns_long:.3e} turns")
+
+    n_over_tau = n_turns_rec / t_dep_turns_long if t_dep_turns_long > 0 else np.nan
+    print(f"  {seed_label}tau_fit(all) = {t_dep_turns_all:.1f} turns, "
+          f"tau_fit(cut@{icTrns}) = {t_dep_turns_long:.1f} turns, "
+          f"N/tau = {n_over_tau:.2f}, fit_reliable = {fit_reliable}")
+
+    return dict(t_dep_turns_all=t_dep_turns_all, t_dep_turns_long=t_dep_turns_long,
+                fit_curve=fit_curve, fit_curve_all=fit_curve_all,
+                fit_reliable=fit_reliable, icTrns=icTrns)
+
+
+def generate_bunch(tw, particle_ref, num_particles, fct=0.0, seed=None,
+                    match_supervisor_epsy_bug=True):
+    """Generate a matched Gaussian macro-particle bunch by hand (as an
+    alternative to xp.generate_matched_gaussian_bunch), optionally including
+    linear spin/orbit coupling terms via `fct`.
+
+    match_supervisor_epsy_bug=True reproduces the supervisor's method of
+    using eps_x (not eps_y) for the vertical plane too -- kept as an explicit,
+    documented opt-in rather than silently "fixed", since flipping it changes
+    the vertical emittance of the generated bunch.
+    """
+    rng = np.random.default_rng(seed)
+
+    epsx = tw.eq_gemitt_x
+    epsy = tw.eq_gemitt_y
+    epsl = tw.eq_gemitt_zeta
+
+    betxin, alfxin = tw.betx[0], tw.alfx[0]
+    betyin, alfyin = tw.bety[0], tw.alfy[0]
+    dxin, dpxin = tw.dx[0], tw.dpx[0]
+    betlin = tw.bets0
+
+    xin, pxin = tw.x[0], tw.px[0]
+    yin, pyin = tw.y[0], tw.py[0]
+    zetain, deltain = tw.zeta[0], tw.delta[0]
+
+    sPxin, sPyin, sPzin = tw.spin_x[0], tw.spin_y[0], tw.spin_z[0]
+    dsPddx = tw.spin_dn_ddelta_x[0]
+    dsPddy = tw.spin_dn_ddelta_y[0]
+    dsPddz = tw.spin_dn_ddelta_z[0]
+
+    eps_y_row = epsx if match_supervisor_epsy_bug else epsy
+
+    normat = np.array([
+        [(epsx*betxin)**.5,          0,                       0, 0, 0, dxin*(epsl/betlin)**.5],
+        [-alfxin*(epsx/betxin)**.5,  (epsx/betxin)**.5,        0, 0, 0, dpxin*(epsl/betlin)**.5],
+        [0, 0,  (eps_y_row*betyin)**.5,          0,                       0, 0],
+        [0, 0,  -alfyin*(eps_y_row/betyin)**.5,  (eps_y_row/betyin)**.5,  0, 0],
+        [0, 0, 0, 0, (epsl*betlin)**.5, 0],
+        [0, 0, 0, 0, 0,                 (epsl/betlin)**.5],
+    ])
+
+    def make_macro_part():
+        x, px, y, py, zeta, delta = normat @ rng.standard_normal(6)
+        sPx = sPxin + fct*(6.5*px*sPzin + delta*dsPddx)
+        sPy = sPyin + fct*(6.5*py*sPzin + delta*dsPddy)
+        sPz = sPzin + fct*(-6.5*(px*sPxin + py*sPyin) + delta*dsPddz)
+        return (x + xin, px + pxin, y + yin, py + pyin,
+                zeta + zetain, delta + deltain, sPx, sPy, sPz)
+
+    parts = np.array([make_macro_part() for _ in range(num_particles)]).T
+
+    return xt.Particles(
+        p0c=particle_ref.p0c[0],
+        mass0=particle_ref.mass0,
+        q0=particle_ref.q0,
+        anomalous_magnetic_moment=0.00,
+        x=parts[0], px=parts[1],
+        y=parts[2], py=parts[3],
+        zeta=parts[4], delta=parts[5],
+        spin_x=parts[6], spin_y=parts[7], spin_z=parts[8],
+    )
+
+
+def prepare_misaligned_line(base_line, misalignment_val, seed, apply_correction=False,
+                             apply_misalignment=True):
+    """Copy `base_line`, apply random misalignments with the given seed, twiss
+    it (spin + polarization), and optionally run orbit correction and
+    re-twiss. Returns (line, tw) ready for particle generation / tracking.
+
+    This is the "copy -> mean radiation -> build tracker -> misalign -> twiss
+    [-> correct -> re-twiss]" sequence duplicated across spin_tracking.py,
+    spin_tracking_single_seed.py and spin_track_fitted.py.
+
+    Set apply_misalignment=False if `base_line` is already misaligned (e.g.
+    loaded from a pre-misaligned JSON) and you only want the correction step.
+    """
+    line = base_line.copy()
+    line.configure_radiation('mean')
+    line.build_tracker(_context=xo.ContextCpu(omp_num_threads=0))
+    if apply_misalignment:
+        line = mc.misalignments(line, misalignment_val, seed=seed)
+
+    tw = line.twiss(method='6d', radiation_integrals=True, eneloss_and_damping=True,
+                     spin=True, polarization=True)
+
+    if apply_correction:
+        orbit_x_rms_before = np.std(tw.x)
+        orbit_y_rms_before = np.std(tw.y)
+        try:
+            mc.orbit_correction(line, tw, threading=False)
+        except Exception as e:
+            print(f"  [seed {seed}] orbit_correction(threading=False) raised: "
+                  f"{type(e).__name__}: {e} -- retrying with threading=True")
+            mc.orbit_correction(line, tw, threading=True)
+        # Re-twiss after correction so tw reflects the corrected orbit/optics.
+        tw = line.twiss(method='6d', radiation_integrals=True, eneloss_and_damping=True,
+                         spin=True, polarization=True)
+        orbit_x_rms_after = np.std(tw.x)
+        orbit_y_rms_after = np.std(tw.y)
+        print(f"  [seed {seed}] orbit RMS x: {orbit_x_rms_before:.3e} -> {orbit_x_rms_after:.3e}, "
+              f"y: {orbit_y_rms_before:.3e} -> {orbit_y_rms_after:.3e}")
+
+    return line, tw
+
+
+def plot_seed_with_textbox(data, title_prefix, out_path):
+    """Plot a turn-by-turn polarization trace with its exponential fit and a
+    summary textbox. `data` must contain: seed, turns, pol, fit, p_bks,
+    p_eq_long, t_dep_turns_all, t_dep_turns_long, t_pol. 'fit_all' and
+    'fit_reliable' are optional.
+    """
+    fig, ax = plt.subplots(figsize=(8, 7))
+    fig.suptitle(f"{title_prefix} - Seed {data['seed']}", fontsize=14, fontweight='bold')
+
+    ax.plot(data['turns'], data['pol'], label='Tracking Data', color='blue', alpha=0.7)
+    ax.plot(data['turns'], data['fit'], color='red', linestyle='--', label='Exp. fit')
+    if 'fit_all' in data:
+        ax.plot(data['turns'], data['fit_all'], color='orange', linestyle=':',
+                label='Exp. fit (all turns)')
+
+    ax.set_ylabel('$P(t)$')
+    ax.set_xlabel('Turns')
+    ax.grid(True, linestyle=':', alpha=0.6)
+    ax.legend()
+
+    reliability_tag = ('fit reliable' if data.get('fit_reliable', True)
+                        else 'FIT UNRELIABLE -- using analytic tau_depol')
+    info_text = (
+        f"$P_{{BKS}}$ = {data['p_bks']:.2f}%   "
+        f"$P_{{eq}}$ (long track) = {data['p_eq_long']:.2f}%\n"
+        f"$\\tau_{{depol}}$ (all turns) = {data['t_dep_turns_all']:.1f} turns   "
+        f"$\\tau_{{depol}}$ (transient removed) = {data['t_dep_turns_long']:.1f} turns\n"
+        f"$t_{{pol}}$ = {data['t_pol']:.4e} s   [{reliability_tag}]\n"
+    )
+    fig.text(0.5, 0.02, info_text, ha='center', va='bottom', fontsize=10,
+              bbox=dict(boxstyle='round', facecolor='whitesmoke', edgecolor='gray', alpha=0.9))
+
+    plt.tight_layout(rect=[0, 0.12, 1, 1])
+    plt.savefig(out_path, dpi=300)
+    plt.close()
+    print(f"  Saved to {out_path}")
+

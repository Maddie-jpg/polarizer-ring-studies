@misc{blondel_polarization_2019,
	title = {Polarization and Centre-of-mass Energy Calibration at {FCC}-ee},
	url = {http://arxiv.org/abs/1909.12245},
	doi = {10.48550/arXiv.1909.12245},
	abstract = {The first stage of the {FCC} (Future Circular Collider) is a high-luminosity electron-positron collider ({FCC}-ee) with centre-of-mass energy ranging from 88 to 365 {GeV}, to study with high precision the Z, W, Higgs and top particles, with samples of \$5 {\textbackslash}times 10{\textasciicircum}\{12\}\$ Z bosons, \$10{\textasciicircum}8\$ W pairs, \$10{\textasciicircum}6\$ Higgs bosons and \$10{\textasciicircum}6\$ top quark pairs. A cornerstone of the physics program lays in the precise (ppm) measurements of the W and Z masses and widths, as well as forward-backward asymmetries. To this effect the centre-of-mass energy distribution should be determined with the high precision. This document describes the capacity offered by {FCC}-ee, starting with transverse polarization of the beams around the Z pole and the W pair threshold. A running scheme based on regular measurements of the beam energy by resonant depolarization of pilot bunches, during physics data taking, is proposed. The design for polarization wigglers, polarimeter and depolarizer is outlined. The \$e{\textasciicircum}{\textbackslash}pm\$ beam energies will be monitored with a relative precision of \$10{\textasciicircum}\{-6\}\$. The centre-of-mass energy is derived subject to further corrections, related to the beam acceleration, synchrotron radiation and beamstrahlung; these effects are identified and evaluated. Dimuon events \$e{\textasciicircum}+e{\textasciicircum}- {\textbackslash}to μ{\textasciicircum}+ μ{\textasciicircum}-\$, recorded in the detectors, provide with great precision the beam crossing angle, the centre-of-mass energy spread, and the \$e{\textasciicircum}+\$ and \$e{\textasciicircum}-\$ energy difference. Monitoring methods to minimize absolute error and relative uncertainties are discussed. The impact on the physics measurements is given. A programme of further simulations, design, monitoring and R\&D is outlined.},
	number = {{arXiv}:1909.12245},
	publisher = {{arXiv}},
	author = {Blondel, Alain and Janot, Patrick and Wenninger, Jörg and Aßmann, Ralf and Aumon, Sandra and Azzurri, Paolo and Barber, Desmond P. and Benedikt, Michael and Bogomyagkov, Anton V. and Gianfelice-Wendt, Eliana and Kerchen, Dima El and Koop, Ivan A. and Koratzinos, Mike and Levitchev, Evgeni and Lefevre, Thibaut and Milanese, Attilio and Muchnoi, Nickolai and Nikitin, Sergey A. and Oide, Katsunobu and Perez, Emmanuel and Rossmanith, Robert and Sagan, David C. and Tenchini, Roberto and Tydecks, Tobias and Shatilov, Dmitry and Voutsinas, Georgios and Wilkinson, Guy and Zimmermann, Frank},
	urldate = {2026-04-16},
	year = {2019},
	eprinttype = {arxiv},
	eprint = {1909.12245 [physics]},
	keywords = {Motivation and Requirements},
	file = {Full Text PDF:/Users/maddiewatson/Zotero/storage/L8KIQW5J/Blondel et al. - 2019 - Polarization and Centre-of-mass Energy Calibration at FCC-ee.pdf:application/pdf;Snapshot:/Users/maddiewatson/Zotero/storage/6XSYU43Y/1909.html:text/html},
}


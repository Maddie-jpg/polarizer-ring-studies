@article{maestre_z_2021,
	title = {The Z lineshape challenge: ppm and {keV} measurements},
	volume = {136},
	issn = {2190-5444},
	url = {http://arxiv.org/abs/2107.00616},
	doi = {10.1140/epjp/s13360-021-01760-x},
	shorttitle = {The Z lineshape challenge},
	abstract = {The {FCC}-ee offers powerful opportunities for direct or indirect evidence for physics beyond the Standard Model, via a combination of high precision measurements and searches for forbidden and rare processes and feebly coupled particles. A key element of {FCC}-ee physics program is the measurement of the Z lineshape from a total of \$5{\textbackslash}times 10{\textasciicircum}\{12\}\$ Z bosons and a beam-energy calibration with relative uncertainty of \$10{\textasciicircum}\{-6\}\$. With this exceptionally large event sample, five orders of magnitude larger than that accumulated during the whole {LEP}1 operation at the Z pole, the defining parameters - \$m\_\{{\textbackslash}rm Z\}\$, \$Γ\_\{{\textbackslash}rm Z\}\$, \$N\_ν\$, \${\textbackslash}sin{\textasciicircum}2θ\_\{{\textbackslash}rm W\}{\textasciicircum}\{{\textbackslash}rm eff\}\$, \$α\_\{{\textbackslash}rm S\}(m\_\{{\textbackslash}rm Z\}{\textasciicircum}2)\$, and \$α\_\{{\textbackslash}rm {QED}\}(m{\textasciicircum}2\_\{{\textbackslash}rm Z\})\$ - can be extracted with a leap in accuracy of up to two orders of magnitude with respect to the current state of the art. The ultimate goal that experimental and theory systematic errors match the statistical accuracy (4{\textbackslash},{keV} on the Z mass and width, \$3{\textbackslash}times 10{\textasciicircum}\{-6\}\$ on \${\textbackslash}sin{\textasciicircum}2θ\_\{{\textbackslash}rm W\}{\textasciicircum}\{{\textbackslash}rm eff\}\$, a relative \$3{\textbackslash}times 10{\textasciicircum}\{-5\}\$ on \$α\_\{{\textbackslash}rm {QED}\}\$, and less than 0.0001 on \$α\_\{{\textbackslash}rm S\}\$) leads to highly demanding requirements on collider operation, beam instrumentation, detector design, computing facilities, theoretical calculations, and Monte Carlo event generators. Such precise measurements also call for innovative analysis methods, which require a joint effort and understanding between theorists, experimenters, and accelerator teams.},
	pages = {848},
	number = {8},
	journal = {The European Physical Journal Plus},
	shortjournal = {Eur. Phys. J. Plus},
	author = {Maestre, Juan Alcaraz and Blondel, Alain and Dam, Mogens and Janot, Patrick},
	urldate = {2026-06-18},
	date = {2021-08},
	year = {2021},
	eprinttype = {arxiv},
	eprint = {2107.00616 [hep-ex]},
	keywords = {Motivation and Requirements},
	file = {Full Text PDF:/Users/maddiewatson/Zotero/storage/Z7P3U78M/Maestre et al. - 2021 - The Z lineshape challenge ppm and keV measurements.pdf:application/pdf;Snapshot:/Users/maddiewatson/Zotero/storage/4TZ3M3MI/2107.html:text/html},
}

@misc{dam_precision_2016,
	title = {Precision Electroweak measurements at the {FCC}-ee},
	url = {http://arxiv.org/abs/1601.03849},
	doi = {10.48550/arXiv.1601.03849},
	abstract = {Because of a luminosity of up to five orders of magnitude larger than at {LEP}, electroweak precision measurements at the {FCC}-ee -- the Future Circular Collider with electron-positron beams -- would provide improvements by orders of magnitude over the present status and constitute a broad search for the existence of new, weakly interacting particles up to very high energy scales. The {FCC}-ee will address centre-of-mass energies ranging from below the Z pole to the \${\textbackslash}mathrm\{t{\textbackslash}bar\{t\}\}\$ threshold and above. At energies around the Z pole, the Z-boson mass and width can be measured to better than 100 {keV} each. Asymmetry measurements at the Z pole allow improvements in the determination of the weak mixing angle by at least a factor 30 to \$δ{\textbackslash}sin{\textasciicircum}2θ{\textbackslash}mathrm\{\_W{\textasciicircum}\{eff\}\}{\textbackslash}simeq 6{\textbackslash}times 10{\textasciicircum}\{-6\}\$. A determination of the electromagnetic coupling constant at the Z energy scale, \$α\_{\textbackslash}mathrm\{{QED}\}(m\_{\textbackslash}mathrm\{Z\}{\textasciicircum}2)\$, to a relative precision of \$3{\textbackslash}times 10{\textasciicircum}\{-5\}\$ can be obtained via measurement of the forward-backward asymmetry of lepton pairs at two energy points \${\textbackslash}pm 3.2{\textbackslash},{\textbackslash}textrm\{{GeV}\}\$ away from the Z peak. At energies around the {WW} threshold, high-statistic cross section measurements can provide a determination of the W mass to 300 {keV}. The key breakthrough advantage of the {FCC}-ee in these achievements, beside the large luminosity, is the possibility of a continous, precise determination of the beam energy by resonant depolarization at the Z peak and at the {WW} threshold. Precise measurements of the hadronic branching fractions of the Z and W bosons allow for considerably improvements in the determination of the strong coupling constant down to a precision of \$δα\_{\textbackslash}mathrm\{s\}(m\_{\textbackslash}mathrm\{Z\}{\textasciicircum}2){\textbackslash}simeq 0.0001\$. An energy scan around the 350 {GeV} \${\textbackslash}mathrm\{t{\textbackslash}bar\{t\}\}\$ threshold allows a 10 {MeV} measurement of the top-quark mass.},
	number = {{arXiv}:1601.03849},
	publisher = {{arXiv}},
	author = {Dam, Mogens},
	urldate = {2026-06-18},
	date = {2016-01-15},
	year={2016},
	eprinttype = {arxiv},
	eprint = {1601.03849 [hep-ex]},
	keywords = {Motivation and Requirements},
	file = {Full Text PDF:/Users/maddiewatson/Zotero/storage/ZR24AN8M/Dam - 2016 - Precision Electroweak measurements at the FCC-ee.pdf:application/pdf;Snapshot:/Users/maddiewatson/Zotero/storage/UX3EB34N/1601.html:text/html},
}

@misc{denterria_physics_2016,
	title = {Physics case of {FCC}-ee},
	url = {http://arxiv.org/abs/1601.06640},
	doi = {10.48550/arXiv.1601.06640},
	abstract = {The physics case for electron-positron beams at the Future Circular Collider ({FCC}-ee) is succinctly summarized. The {FCC}-ee core program involves \$e{\textasciicircum}+e{\textasciicircum}-\$ collisions at \${\textbackslash}sqrt\{s\}\$ = 90, 160, 240, and 350 {GeV} with multi-ab\${\textasciicircum}\{-1\}\$ integrated luminosities, yielding about 10\${\textasciicircum}\{12\}\$ Z bosons, 10\${\textasciicircum}\{8\}\$ W\${\textasciicircum}+\$W\${\textasciicircum}-\$ pairs, 10\${\textasciicircum}\{6\}\$ Higgs bosons and 4\${\textbackslash}cdot\$10\${\textasciicircum}\{5\}\$ \$t{\textbackslash}bar\{t\}\$ pairs per year. The huge luminosities combined with \${\textbackslash}cal\{100\}\$ {keV} knowledge of the c.m. energy will allow for Standard Model studies at unrivaled precision. Indirect constraints on new physics can thereby be placed up to scales \$Λ\_\{\_\{{\textbackslash}rm {NP}\}\} {\textbackslash}approx\$ 7 and 100 {TeV} for particles coupling respectively to the Higgs and electroweak bosons.},
	number = {{arXiv}:1601.06640},
	publisher = {{arXiv}},
	author = {d'Enterria, David},
	urldate = {2026-06-18},
	date = {2016-01-25},
	year={2016},
	eprinttype = {arxiv},
	eprint = {1601.06640 [hep-ex]},
	keywords = {Motivation and Requirements},
	file = {Full Text PDF:/Users/maddiewatson/Zotero/storage/MF79MFHQ/d'Enterria - 2016 - Physics case of FCC-ee.pdf:application/pdf;Snapshot:/Users/maddiewatson/Zotero/storage/DDA6H3Y6/1601.html:text/html},
}

@article{azzi_higgs_2022,
	title = {Higgs and top physics reconstruction challenges and opportunities at {FCC}-ee},
	volume = {137},
	issn = {2190-5444},
	url = {http://arxiv.org/abs/2107.05003},
	doi = {10.1140/epjp/s13360-021-02223-z},
	abstract = {The Higgs bosons and the top quark decay into rich and diverse final states, containing both light and heavy quarks, gluons, photons as well as W and Z bosons. This article reviews the challenges involved in reconstructing Higgs and top events at the {FCC}-ee and identifies the areas where novel developments are needed. The precise identification and reconstruction of these final states at the {FCC}-ee rely on the capability of the detector to provide excellent flavour tagging, jet energy and angular resolution, and global kinematic event reconstruction. Excellent flavour tagging performance requires low-material vertex and tracking detectors, and advanced machine learning techniques as successfully employed in {LHC} experiments. In addition, the Z pole run will provide abundant samples of heavy flavour partons that can be used for calibration of the tagging algorithms. For the reconstruction of jets, leptons, and missing energy, particle-flow algorithms are crucial to explore the full potential of the highly granular tracking and calorimeter systems, and give access to excellent energy-momentum resolution and precise identification of heavy bosons in their hadronic decays. This enables, among many other key elements, the reconstruction of Higgsstrahlung processes with leptonically and hadronically decaying Z bosons, and an almost background-free identification of top quark pair events. Exploiting the full available kinematic constraints together with exclusive jet clustering algorithms will allow for the optimisation of global event reconstruction with kinematic fitting techniques.},
	pages = {39},
	number = {1},
	journaltitle = {The European Physical Journal Plus},
	shortjournal = {Eur. Phys. J. Plus},
	author = {Azzi, Patrizia and Gouskos, Loukas and Selvaggi, Michele and Simon, Frank},
	urldate = {2026-06-18},
	date = {2022-01},
	eprinttype = {arxiv},
	eprint = {2107.05003 [hep-ex]},
	keywords = {Motivation and Requirements},
	file = {Full Text PDF:/Users/maddiewatson/Zotero/storage/GVWX7GFF/Azzi et al. - 2022 - Higgs and top physics reconstruction challenges and opportunities at FCC-ee.pdf:application/pdf;Snapshot:/Users/maddiewatson/Zotero/storage/KDD35WPH/2107.html:text/html},
}

